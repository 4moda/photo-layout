# fastlane snapshot 設定（各操作を自動撮影し screenshots.html を生成）
# CI(macOS)で、このディレクトリ（AppTests/PhotoLayoutUITests）をCWDにして
# `fastlane snapshot` を実行する。ビルドは build-for-testing を再利用。
# パスはCWD（＝UITestディレクトリ）基準。xcodeproj/DerivedData はリポジトリ直下(../../)。

# XcodeGen生成のプロジェクトはリポジトリ直下。CWDからの相対で指定する。
project("../../PhotoLayout.xcodeproj")

# iPhone 17（標準）＋ iPhone 16e（最小6.1"幅＝コンパイル/レイアウト崩れの検知用。
# macOS 26イメージのシミュレータにiPhone SE系がなくなったため最小幅機種として採用）。
# CIは機種ごとに独立したジョブ（matrix）で並列撮影し、SNAPSHOT_DEVICES（カンマ区切り）で
# そのジョブが担当する機種だけに絞り込む。未設定時（ローカル実行）は全機種を逐次撮影する。
default_devices = ["iPhone 17", "iPhone 16e"]
devices(ENV["SNAPSHOT_DEVICES"]&.split(",") || default_devices)
languages(["ja-JP"])

scheme("PhotoLayout")

# build-for-testing の成果物（リポジトリ直下の DerivedData）を再利用（再ビルドしない）
derived_data_path("../../DerivedData")
test_without_building(true)

# UIテストのみ撮影対象（ユニットテストは別ステップで実行）。
# CIは機種matrixに加えテーマ（ライト/ダーク）でも独立したジョブに分け並列撮影する。
# SNAPSHOT_ONLY_TESTING / SNAPSHOT_SKIP_TESTING（いずれもカンマ区切り、空文字は未指定扱い）で
# 各ジョブが担当するテストメソッドだけに絞り込む。未設定時（ローカル実行）は全メソッドを撮影する。
def env_list(key)
  value = ENV[key]
  return nil if value.nil? || value.strip.empty?
  value.split(",")
end

only_testing(env_list("SNAPSHOT_ONLY_TESTING") || ["PhotoLayoutUITests"])
if (skip = env_list("SNAPSHOT_SKIP_TESTING"))
  skip_testing(skip)
end

# シミュレータの外観（ライト/ダーク）。テストプロセス内からの `XCUIDevice.shared.appearance`
# 切り替えは `test_without_building` 経由のCI実行では効かないため、fastlane snapshot自身が
# アプリ起動前にシミュレータのpreferenceファイルへ直接書き込む dark_mode オプションを使う。
# SNAPSHOT_DARK_MODE（"true"のときのみダーク）。未設定時（ローカル実行）はライトのまま。
dark_mode(ENV["SNAPSHOT_DARK_MODE"] == "true")

# 出力はこのツール群と同じ場所（AppTests/PhotoLayoutUITests/fastlane/screenshots）
output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
skip_open_summary(true)
concurrent_simulators(false)
