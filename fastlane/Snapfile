# fastlane snapshot 設定（各操作を自動撮影し screenshots.html を生成）
# CI(macOS)で `fastlane snapshot` により実行される。ビルドは build-for-testing を再利用。

devices(["iPhone 16"])
languages(["ja-JP"])

scheme("PhotoLayout")

# build-for-testing の成果物を再利用（再ビルドしない）
derived_data_path("DerivedData")
test_without_building(true)

# UIテストのみ撮影対象（ユニットテストは別ステップで実行）
only_testing(["PhotoLayoutUITests"])

output_directory("./fastlane/screenshots")
clear_previous_screenshots(true)
skip_open_summary(true)
concurrent_simulators(false)
